DATABASE_URL=postgresql+asyncpg://hpf:hpf@localhost:5432/hpf_work
SECRET_KEY=change-me-in-production  # 生产环境请用: python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# MCP Server（AI 工具接入）
MCP_ENABLED=true
MCP_PATH=/mcp
# MCP DNS 防重绑定允许的 Host（逗号分隔）；留空则从 CORS_ORIGINS 推导
MCP_ALLOWED_HOSTS=
