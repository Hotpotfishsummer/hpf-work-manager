# ============================================================
# HPF Work Manager 环境变量模板
# 用法：cp .env.example .env 后按需修改
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=hpf
POSTGRES_PASSWORD=hpf
POSTGRES_DB=hpf_work

# ---- 后端 ----
# 生产环境务必替换：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8080

# ---- MCP Server（AI 工具接入）----
# 是否启用 MCP Streamable HTTP 端点，默认 true
MCP_ENABLED=true
# MCP 端点路径，AI 工具连接地址 = {前端地址}/mcp
MCP_PATH=/mcp
# MCP DNS 防重绑定允许的 Host（逗号分隔）。留空则从 CORS_ORIGINS 推导。
# 例：MCP_ALLOWED_HOSTS=work.example.com,localhost
MCP_ALLOWED_HOSTS=

# ---- 端口 ----
FRONTEND_PORT=8080
