# ============================================================
# HPF Work Manager 环境变量模板
# 用法：cp .env.example .env 后按需修改
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=hpf
POSTGRES_PASSWORD=hpf
POSTGRES_DB=hpf_work

# ---- 后端 ----
# 运行环境：dev 允许默认密钥；production 等其他值强制强密钥（fail-fast，否则拒绝启动）
ENVIRONMENT=production
# ⚠️ 非 dev 环境必须替换（≥32 字符），否则启动失败：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8080

# ---- MCP Server（AI 工具接入）----
# 是否启用 MCP Streamable HTTP 端点，默认 true
MCP_ENABLED=true
# MCP 端点路径，AI 工具连接地址 = {前端地址}/mcp
MCP_PATH=/mcp
# MCP DNS 防重绑定允许的 Host（逗号分隔）。留空则从 CORS_ORIGINS 推导。
# 例：MCP_ALLOWED_HOSTS=work.example.com,localhost
MCP_ALLOWED_HOSTS=

# ---- 展示时区 ----
# 逾期/今日完成/进度快照/燃尽分桶等"日历今天"按该时区判定（IANA 名称）
DISPLAY_TIMEZONE=Asia/Shanghai

# ---- MiniMax 算力雷达（可选）----
# 用于「5h 算力调度雷达」与 AI 规划推演。留空则相关功能自动降级
# （雷达显示"未配置"，灵感工坊/规划推演回落到确定性启发式引擎），不影响其它功能。
# ⚠️ 本仓库是公开的：密钥只写在本文件对应的 .env 里（已被 .gitignore 忽略），
#    绝不要写进代码、docker-compose.yml 或任何被跟踪的文件。
MINIMAX_API_KEY=

# ---- 端口 ----
FRONTEND_PORT=8080
